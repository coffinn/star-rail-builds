---
import { t } from '../utils/i18n';
import InlineNoteLabel from './InlineNoteLabel.astro';

type TraceItem = {
  id?: string;
  name: string;
  note?: string;
  noteId?: string;
};

type TracePriority = {
  items: TraceItem[];
  approx?: boolean;
};

type TraceRecommendations = {
  traces: TracePriority[];
};

const {
  traces,
  locale,
} = Astro.props as {
  traces: TraceRecommendations;
  locale: any;
};

const hasNoteMarker = (
  item: TraceItem,
) => item.noteId || item.note;

const traceRows = traces.traces.map(
  (
    trace: TracePriority,
    index: number,
  ) => ({
    rank: index + 1,

    mainItems: trace.approx
      ? trace.items.slice(0, 1)
      : trace.items,

    alternativeItems: trace.approx
      ? trace.items.slice(1)
      : [],
  }),
);
---

<div class="card recommendation-card talent-card">
  <h2>
    {t(locale, 'ui', 'Traces')}
  </h2>

  <div class="recommendation-card-body">
    <div class="rank-list">
      {
        traceRows.map((trace) => (
          <div class="rank-group">

            <div class="rank-row">
              <strong class="rank-number">
                {trace.rank}
              </strong>

              <span class="rank-content">
                {
                  trace.mainItems.map(
                    (
                      item,
                      itemIndex,
                    ) => (
                      <>
                        {itemIndex > 0 && ' = '}

                        <InlineNoteLabel
                          label={item.name}
                          noteId={item.noteId}
                          hasNote={Boolean(
                            hasNoteMarker(item),
                          )}
                          emphasized
                        />
                      </>
                    ),
                  )
                }
              </span>
            </div>

            {
              trace.alternativeItems.map(
                (item) => (
                  <div class="rank-row alt">
                    <span class="rank-approx">
                      &asymp;
                    </span>

                    <span class="rank-content">
                      <InlineNoteLabel
                        label={item.name}
                        noteId={item.noteId}
                        hasNote={Boolean(
                          hasNoteMarker(item),
                        )}
                        emphasized
                      />
                    </span>
                  </div>
                ),
              )
            }

          </div>
        ))
      }
    </div>
  </div>
</div>