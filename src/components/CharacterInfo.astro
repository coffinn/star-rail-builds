---
import {
    renderCharacterAbilityDescription,
    type CharacterAbility,
    type CharacterAbilityVariant,
    type CharacterData,
} from '../utils/character-data';
import HighlightedText from './HighlightedText.astro';

const { character } = Astro.props as {
    character: CharacterData;
};

type SelectableAbilityVariant = CharacterAbilityVariant & {
    id?: string;
    selector_label?: string;
};

type SelectableCharacterAbility = CharacterAbility & {
    variant_selector?: {
        label?: string;
    };
    variants?: SelectableAbilityVariant[];
};

const abilityOrder = ['basic', 'skill', 'ultimate', 'talent', 'technique'];

const normalAbilities = abilityOrder
    .map((id) => {
        const ability = character.abilities?.[id];

        if (!ability) {
            return null;
        }

        return {
            id,
            ability,
        };
    })
    .filter(
        (
            item,
        ): item is {
            id: string;
            ability: CharacterAbility;
        } => item !== null,
    );

const memospriteAbilities = Object.entries(
    character.memosprite?.skills ?? {},
).map(([id, ability]) => ({
    id: `memosprite:${id}`,
    ability,
}));

const elationAbilities = Object.entries(character.elation?.skills ?? {}).map(
    ([id, ability]) => ({
        id: `elation:${id}`,
        ability,
    }),
);

const globalPassives = Object.entries(character.global_passives ?? {}).map(
    ([id, passive]) => ({
        id,
        passive,
    }),
);

const abilitySections = [
    {
        id: 'normal',
        title: 'Abilities',
        abilities: normalAbilities,
    },

    ...(character.memosprite && memospriteAbilities.length > 0
        ? [
              {
                  id: 'memosprite',
                  title: `Memosprite — ${character.memosprite.name}`,
                  abilities: memospriteAbilities,
              },
          ]
        : []),

    ...(elationAbilities.length > 0
        ? [
              {
                  id: 'elation',
                  title: 'Elation',
                  abilities: elationAbilities,
              },
          ]
        : []),
];

const majorTraces = Object.entries(character.major_traces ?? {}).sort(
    ([a], [b]) => Number(a) - Number(b),
);

const eidolons = [...(character.eidolons ?? [])].sort(
    (a, b) => a.level - b.level,
);

const getDefaultLevel = (ability: CharacterAbility) => {
    const min = ability.min_level ?? 1;

    const max = ability.max_level ?? min;

    return Math.max(min, Math.min(ability.default_level ?? max, max));
};

const getAbilityLevels = (ability: CharacterAbility) => {
    const min = ability.min_level ?? 1;

    const max = ability.max_level ?? min;

    return Array.from(
        {
            length: max - min + 1,
        },
        (_, index) => min + index,
    );
};
const renderVariantDescription = (
    variant: CharacterAbilityVariant,
    parentAbility: CharacterAbility,
    requestedLevel?: number,
) => {
    if (!variant.description_template || !variant.scaling) {
        return variant.description ?? '';
    }

    const minLevel = parentAbility.min_level ?? 1;

    const maxLevel = parentAbility.max_level ?? minLevel;

    const defaultLevel = parentAbility.default_level ?? maxLevel;

    const level = Math.max(
        minLevel,
        Math.min(requestedLevel ?? defaultLevel, maxLevel),
    );

    const index = level - minLevel;

    return variant.description_template.replace(
        /\{\{([a-zA-Z0-9_-]+)\}\}/g,
        (match, key: string) => {
            const value = variant.scaling?.[key]?.[index];

            return value === undefined ? match : String(value);
        },
    );
};
---

<section class="card character-info-card">
    <h2>Character Info</h2>

    <!-- ========================= -->
    <!-- Level 80 Stats            -->
    <!-- ========================= -->

    {
        character.level_80_stats && (
            <section class="character-info-section">
                <h3>Level 80 Stats</h3>

                <div class="character-stat-grid">
                    {character.level_80_stats.hp !== undefined && (
                        <span>
                            HP
                            <strong>{character.level_80_stats.hp}</strong>
                        </span>
                    )}

                    {character.level_80_stats.atk !== undefined && (
                        <span>
                            ATK
                            <strong>{character.level_80_stats.atk}</strong>
                        </span>
                    )}

                    {character.level_80_stats.def !== undefined && (
                        <span>
                            DEF
                            <strong>{character.level_80_stats.def}</strong>
                        </span>
                    )}

                    {character.level_80_stats.spd !== undefined && (
                        <span>
                            SPD
                            <strong>{character.level_80_stats.spd}</strong>
                        </span>
                    )}

                    {character.max_energy != null && (
                        <span>
                            Energy
                            <strong>{character.max_energy}</strong>
                        </span>
                    )}
                </div>
            </section>
        )
    }

    <!-- ========================= -->
    <!-- Abilities                 -->
    <!-- ========================= -->

    {
        abilitySections.map((section) => (
            <section class="character-info-section">
                <h3>{section.title}</h3>

                {section.id === 'memosprite' && character.memosprite && (
                    <div class="character-detail-meta character-mechanic-meta">
                        {character.memosprite.initial_spd !== undefined && (
                            <span>
                                Initial SPD:{' '}
                                <strong>
                                    {character.memosprite.initial_spd}
                                </strong>
                            </span>
                        )}

                        {character.memosprite.hp_source && (
                            <span>
                                Max HP:{' '}
                                <strong>
                                    {character.memosprite.hp_source}
                                </strong>
                            </span>
                        )}
                    </div>
                )}

                <div class="character-info-details character-ability-grid">
                    {section.abilities.map(({ id, ability }) => {
                        const minLevel = ability.min_level ?? 1;

                        const maxLevel = ability.max_level ?? minLevel;

                        const defaultLevel = getDefaultLevel(ability);

                        const levels = getAbilityLevels(ability);

                        const scalable =
                            Boolean(
                                ability.description_template && ability.scaling,
                            ) && maxLevel > minLevel;

                        const selectableAbility =
                            ability as SelectableCharacterAbility;

                        const variants = selectableAbility.variants ?? [];

                        const variantSelector =
                            selectableAbility.variant_selector;

                        return (
                            <details
                                open
                                data-character-ability={id}
                                data-static-detail
                            >
                                <summary>
                                    <strong>{ability.type}</strong>

                                    <span class="character-ability-name">
                                        {ability.name}
                                    </span>

                                    {scalable && (
                                        <span
                                            class="character-ability-level"
                                            data-character-level-value
                                        >
                                            Lv. {defaultLevel}
                                        </span>
                                    )}
                                </summary>

                                <div class="character-detail-body">
                                    {ability.tag && (
                                        <p class="character-ability-tag">
                                            <strong>Type:</strong> {ability.tag}
                                        </p>
                                    )}

                                    <div class="character-detail-meta">
                                        {ability.energy_gain !== undefined && (
                                            <span>
                                                Energy Gain:{' '}
                                                <strong>
                                                    {ability.energy_gain}
                                                </strong>
                                            </span>
                                        )}

                                        {ability.energy_cost !== undefined && (
                                            <span>
                                                Energy Cost:{' '}
                                                <strong>
                                                    {ability.energy_cost}
                                                </strong>
                                            </span>
                                        )}

                                        {ability.break !== undefined && (
                                            <span>
                                                Break:{' '}
                                                <strong>{ability.break}</strong>
                                            </span>
                                        )}

                                        {ability.break_main !== undefined && (
                                            <span>
                                                Break (Main):{' '}
                                                <strong>
                                                    {ability.break_main}
                                                </strong>
                                            </span>
                                        )}

                                        {ability.break_adjacent !==
                                            undefined && (
                                            <span>
                                                Break (Adjacent):{' '}
                                                <strong>
                                                    {ability.break_adjacent}
                                                </strong>
                                            </span>
                                        )}

                                        {ability.break_aoe !== undefined && (
                                            <span>
                                                Break (AoE):{' '}
                                                <strong>
                                                    {ability.break_aoe}
                                                </strong>
                                            </span>
                                        )}
                                    </div>

                                    {scalable && (
                                        <div class="character-trace-slider">
                                            <div class="character-slider-header">
                                                <strong>Trace Level</strong>

                                                <span
                                                    data-character-level-value
                                                >
                                                    Lv. {defaultLevel}
                                                </span>
                                            </div>

                                            <input
                                                type="range"
                                                min={minLevel}
                                                max={maxLevel}
                                                step="1"
                                                value={defaultLevel}
                                                data-character-level-slider
                                                aria-label={`${ability.name} Trace Level`}
                                            />

                                            <div class="character-slider-bounds">
                                                <span>Lv. {minLevel}</span>

                                                <span>Lv. {maxLevel}</span>
                                            </div>
                                        </div>
                                    )}

                                    <div class="character-ability-description">
                                        {scalable ? (
                                            levels.map((level) => (
                                                <p
                                                    data-character-level-panel={
                                                        level
                                                    }
                                                    hidden={
                                                        level !== defaultLevel
                                                    }
                                                >
                                                    <HighlightedText
                                                        text={renderCharacterAbilityDescription(
                                                            ability,
                                                            level,
                                                            minLevel,
                                                            defaultLevel,
                                                        )}
                                                    />
                                                </p>
                                            ))
                                        ) : (
                                            <p>
                                                <HighlightedText
                                                    text={renderCharacterAbilityDescription(
                                                        ability,
                                                        undefined,
                                                        minLevel,
                                                        defaultLevel,
                                                    )}
                                                />
                                            </p>
                                        )}
                                    </div>

                                    {variants.length > 0 && (
                                        <div
                                            class="character-ability-variants"
                                            data-ability-variants
                                        >
                                            {variantSelector && (
                                                <label class="character-variant-selector">
                                                    <span>
                                                        {variantSelector.label ??
                                                            'Select'}
                                                    </span>

                                                    <select
                                                        data-variant-select
                                                        aria-label={
                                                            variantSelector.label ??
                                                            'Select alternate ability'
                                                        }
                                                    >
                                                        {variants.map(
                                                            (
                                                                variant,
                                                                index,
                                                            ) => (
                                                                <option
                                                                    value={
                                                                        variant.id ??
                                                                        String(
                                                                            index,
                                                                        )
                                                                    }
                                                                >
                                                                    {variant.selector_label ??
                                                                        variant.name}
                                                                </option>
                                                            ),
                                                        )}
                                                    </select>
                                                </label>
                                            )}

                                            {variants.map((variant, index) => {
                                                const variantScalable =
                                                    Boolean(
                                                        variant.description_template &&
                                                        variant.scaling,
                                                    ) && maxLevel > minLevel;

                                                const variantId =
                                                    variant.id ?? String(index);

                                                return (
                                                    <section
                                                        class="character-ability-variant"
                                                        data-ability-variant
                                                        data-variant-id={
                                                            variantId
                                                        }
                                                        hidden={
                                                            variantSelector
                                                                ? index !== 0
                                                                : false
                                                        }
                                                    >
                                                        <div class="character-ability-variant-header">
                                                            <strong>
                                                                {variant.type}
                                                            </strong>

                                                            <span class="character-ability-name">
                                                                {variant.name}
                                                            </span>
                                                        </div>

                                                        {variant.tag && (
                                                            <p class="character-ability-tag">
                                                                <strong>
                                                                    Type:
                                                                </strong>{' '}
                                                                {variant.tag}
                                                            </p>
                                                        )}

                                                        <div class="character-detail-meta">
                                                            {variant.energy_gain !==
                                                                undefined && (
                                                                <span>
                                                                    Energy Gain:{' '}
                                                                    <strong>
                                                                        {
                                                                            variant.energy_gain
                                                                        }
                                                                    </strong>
                                                                </span>
                                                            )}

                                                            {variant.energy_cost !==
                                                                undefined && (
                                                                <span>
                                                                    Energy Cost:{' '}
                                                                    <strong>
                                                                        {
                                                                            variant.energy_cost
                                                                        }
                                                                    </strong>
                                                                </span>
                                                            )}

                                                            {variant.break !==
                                                                undefined && (
                                                                <span>
                                                                    Break:{' '}
                                                                    <strong>
                                                                        {
                                                                            variant.break
                                                                        }
                                                                    </strong>
                                                                </span>
                                                            )}

                                                            {variant.break_main !==
                                                                undefined && (
                                                                <span>
                                                                    Break
                                                                    (Main):{' '}
                                                                    <strong>
                                                                        {
                                                                            variant.break_main
                                                                        }
                                                                    </strong>
                                                                </span>
                                                            )}

                                                            {variant.break_adjacent !==
                                                                undefined && (
                                                                <span>
                                                                    Break
                                                                    (Adjacent):{' '}
                                                                    <strong>
                                                                        {
                                                                            variant.break_adjacent
                                                                        }
                                                                    </strong>
                                                                </span>
                                                            )}

                                                            {variant.break_aoe !==
                                                                undefined && (
                                                                <span>
                                                                    Break (AoE):{' '}
                                                                    <strong>
                                                                        {
                                                                            variant.break_aoe
                                                                        }
                                                                    </strong>
                                                                </span>
                                                            )}
                                                        </div>

                                                        <div class="character-ability-description">
                                                            {variantScalable ? (
                                                                levels.map(
                                                                    (level) => (
                                                                        <p
                                                                            data-character-level-panel={
                                                                                level
                                                                            }
                                                                            hidden={
                                                                                level !==
                                                                                defaultLevel
                                                                            }
                                                                        >
                                                                            <HighlightedText
                                                                                text={renderVariantDescription(
                                                                                    variant,
                                                                                    ability,
                                                                                    level,
                                                                                )}
                                                                            />
                                                                        </p>
                                                                    ),
                                                                )
                                                            ) : (
                                                                <p>
                                                                    <HighlightedText
                                                                        text={renderVariantDescription(
                                                                            variant,
                                                                            ability,
                                                                        )}
                                                                    />
                                                                </p>
                                                            )}
                                                        </div>
                                                    </section>
                                                );
                                            })}
                                        </div>
                                    )}
                                </div>
                            </details>
                        );
                    })}
                </div>
            </section>
        ))
    }

    {
        globalPassives.length > 0 && (
            <section class="character-info-section">
                <h3>Global Passives</h3>

                <div class="character-global-passive-grid">
                    {globalPassives.map(({ id, passive }) => (
                        <article
                            class="character-global-passive-card"
                            data-global-passive={id}
                        >
                            <div class="character-global-passive-header">
                                <strong class="character-global-passive-type">
                                    Global
                                    <small>Passive</small>
                                </strong>

                                <div class="character-global-passive-title">
                                    <span class="character-ability-name">
                                        {passive.name}
                                    </span>

                                    {passive.tag && (
                                        <small>{passive.tag}</small>
                                    )}
                                </div>
                            </div>

                            <div class="character-global-passive-body">
                                <p>
                                    <HighlightedText
                                        text={passive.description}
                                    />
                                </p>
                            </div>
                        </article>
                    ))}
                </div>
            </section>
        )
    }

    <!-- ========================= -->
    <!-- Major Traces              -->
    <!-- ========================= -->

    <section class="character-info-section">
        <h3>Major Traces</h3>

        <div class="character-info-details character-major-trace-grid">
            {
                majorTraces.map(([ascension, trace]) => (
                    <details open data-static-detail>
                        <summary>
                            <strong class="character-major-trace-label">
                                <span>A{ascension}</span>
                                <small>Major Trace</small>
                            </strong>

                            <span>{trace.name}</span>
                        </summary>

                        <div class="character-detail-body">
                            <p>
                                <HighlightedText text={trace.description} />
                            </p>
                        </div>
                    </details>
                ))
            }
        </div>
    </section>

    <!-- ========================= -->
    <!-- Stat Bonuses              -->
    <!-- ========================= -->

    <section class="character-info-section">
        <h3>Stat Bonuses</h3>

        <div class="character-stat-grid">
            {
                character.stat_bonuses.map((bonus) => (
                    <span>
                        {bonus.stat}

                        <strong>{bonus.value}</strong>
                    </span>
                ))
            }
        </div>
    </section>

    <!-- ========================= -->
    <!-- Eidolons                  -->
    <!-- ========================= -->

    <section class="character-info-section">
        <h3>Eidolons</h3>

        <div class="character-info-details character-eidolon-grid">
            {
                eidolons.map((eidolon) => (
                    <details open data-static-detail>
                        <summary>
                            <strong>E{eidolon.level}</strong>

                            <span>{eidolon.name}</span>
                        </summary>

                        <div class="character-detail-body">
                            <p>
                                <HighlightedText text={eidolon.description} />
                            </p>
                        </div>
                    </details>
                ))
            }
        </div>
    </section>
</section>

<script>
    document
        .querySelectorAll<HTMLDetailsElement>('details[data-static-detail]')
        .forEach((detail) => {
            const summary = detail.querySelector('summary');

            if (!summary) {
                return;
            }

            summary.addEventListener('click', (event) => {
                event.preventDefault();
            });
        });
    document
        .querySelectorAll<HTMLElement>('[data-character-ability]')
        .forEach((ability) => {
            const slider = ability.querySelector<HTMLInputElement>(
                '[data-character-level-slider]',
            );

            if (!slider) {
                return;
            }

            const levelLabels = ability.querySelectorAll<HTMLElement>(
                '[data-character-level-value]',
            );

            const panels = ability.querySelectorAll<HTMLElement>(
                '[data-character-level-panel]',
            );

            const updateLevel = () => {
                const level = slider.value;

                levelLabels.forEach((label) => {
                    label.textContent = `Lv. ${level}`;
                });

                panels.forEach((panel) => {
                    panel.hidden = panel.dataset.characterLevelPanel !== level;
                });
            };

            slider.addEventListener('input', updateLevel);
        });

    document
        .querySelectorAll<HTMLElement>('[data-ability-variants]')
        .forEach((container) => {
            const select = container.querySelector<HTMLSelectElement>(
                '[data-variant-select]',
            );

            if (!select) {
                return;
            }

            const variantPanels = Array.from(
                container.querySelectorAll<HTMLElement>(
                    '[data-ability-variant]',
                ),
            );

            const updateVariant = () => {
                variantPanels.forEach((panel) => {
                    panel.hidden = panel.dataset.variantId !== select.value;
                });
            };

            select.addEventListener('change', updateVariant);

            updateVariant();
        });
</script>

<style>
    /* =====================================================
       Static detail behavior
       ===================================================== */

    .character-info-details details[data-static-detail] > summary {
        cursor: default;
        list-style: none;
    }

    .character-info-details
        details[data-static-detail]
        > summary::-webkit-details-marker {
        display: none;
    }

    .character-info-details details[data-static-detail] > summary::marker {
        display: none;
    }

    /* =====================================================
       Main Character Info surfaces
       ===================================================== */

    .character-info-card {
        box-sizing: border-box;

        width: 100%;
        max-width: 100%;
        min-width: 0;

        margin-top: 0;

        border-radius: 8px;

        background:
            linear-gradient(
                180deg,
                rgba(255, 255, 255, 0.045),
                rgba(255, 255, 255, 0.015)
            ),
            rgba(5, 8, 12, 0.28);

        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    }

    .character-info-section {
        box-sizing: border-box;

        width: 100%;
        max-width: 100%;
        min-width: 0;

        padding: 10px;

        border-radius: 8px;

        background: rgba(7, 10, 15, 0.18);

        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    }

    .character-info-section + .character-info-section {
        margin-top: 1.5rem;
    }

    .character-info-section > h3 {
        margin-top: 0;
        margin-bottom: 10px;
    }

    /* =====================================================
       Stats
       ===================================================== */

    .character-stat-grid {
        display: grid;

        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));

        width: 100%;
        min-width: 0;

        gap: 0.75rem;
    }

    .character-stat-grid > span {
        display: flex;
        justify-content: space-between;

        min-width: 0;

        gap: 0.75rem;

        padding: 0.65rem 0.8rem;

        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 0.5rem;

        background: rgba(255, 255, 255, 0.04);
    }

    /* =====================================================
       Detail grids
       ===================================================== */

    .character-info-details {
        display: grid;

        width: 100%;
        max-width: 100%;
        min-width: 0;

        gap: 0.5rem;
    }

    .character-info-details details {
        box-sizing: border-box;

        width: 100%;
        max-width: 100%;
        min-width: 0;

        overflow: hidden;

        border-radius: 0.5rem;
    }

    .character-info-details > details {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;

        background: rgba(255, 255, 255, 0.035);
    }

    .character-ability-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-items: stretch;
    }

    .character-major-trace-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        align-items: stretch;
    }

    .character-eidolon-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-items: stretch;
    }

    .character-ability-grid > details,
    .character-major-trace-grid > details,
    .character-eidolon-grid > details {
        height: 100%;
    }

    /* =====================================================
       Detail headers
       ===================================================== */

    .character-info-details summary {
        box-sizing: border-box;

        display: flex;
        align-items: center;

        width: 100%;
        max-width: 100%;
        min-width: 0;

        gap: 0.75rem;

        padding: 0.7rem 0.8rem;

        cursor: pointer;
    }

    .character-info-details > details > summary {
        border-bottom: 1px solid rgba(255, 255, 255, 0.065);

        background: rgba(255, 255, 255, 0.025);
    }

    .character-info-details summary > span {
        min-width: 0;

        overflow-wrap: anywhere;
    }

    .character-ability-level {
        flex: 0 0 auto;

        margin-left: auto;

        opacity: 0.75;
    }

    /* =====================================================
       Detail body
       ===================================================== */

    .character-detail-body {
        box-sizing: border-box;

        width: 100%;
        max-width: 100%;
        min-width: 0;

        padding: 10px 12px 12px;

        background: rgba(0, 0, 0, 0.16);
    }

    .character-detail-body p {
        max-width: 100%;
        min-width: 0;

        overflow-wrap: anywhere;
    }

    .character-ability-tag {
        margin-top: 0;
    }

    .character-mechanic-meta {
        margin-bottom: 10px;
    }

    .character-detail-meta {
        display: flex;
        flex-wrap: wrap;

        gap: 0.5rem 1rem;

        margin: 8px 0;

        padding: 6px 8px;

        border-radius: 6px;

        background: rgba(255, 255, 255, 0.045);

        font-size: 0.9rem;

        opacity: 0.8;
    }

    /* =====================================================
       Trace slider
       ===================================================== */

    .character-trace-slider {
        box-sizing: border-box;

        display: grid;

        width: 50%;
        max-width: 420px;
        min-width: 240px;

        gap: 0.3rem;

        margin: 0.75rem 0;

