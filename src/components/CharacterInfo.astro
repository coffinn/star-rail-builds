---
import {
    renderCharacterAbilityDescription,
    type CharacterAbility,
    type CharacterData,
} from '../utils/character-data';

const { character } = Astro.props as {
    character: CharacterData;
};

const abilityOrder = ['basic', 'skill', 'ultimate', 'talent', 'technique'];

const abilities = abilityOrder
    .map((id) => {
        const ability = character.abilities?.[id];

        if (!ability) {
            return null;
        }

        return {
            id,
            ability,
        };
    })
    .filter(
        (
            item,
        ): item is {
            id: string;
            ability: CharacterAbility;
        } => item !== null,
    );

const majorTraces = Object.entries(character.major_traces ?? {}).sort(
    ([a], [b]) => Number(a) - Number(b),
);

const eidolons = [...(character.eidolons ?? [])].sort(
    (a, b) => a.level - b.level,
);

const getDefaultLevel = (ability: CharacterAbility) => {
    const min = ability.min_level ?? 1;

    const max = ability.max_level ?? min;

    return Math.max(min, Math.min(ability.default_level ?? max, max));
};

const getAbilityLevels = (ability: CharacterAbility) => {
    const min = ability.min_level ?? 1;

    const max = ability.max_level ?? min;

    return Array.from(
        {
            length: max - min + 1,
        },
        (_, index) => min + index,
    );
};
---

<section class="card character-info-card">
    <h2>Character Info</h2>

    <!-- ========================= -->
    <!-- Level 80 Stats            -->
    <!-- ========================= -->

    {
        character.level_80_stats && (
            <section class="character-info-section">
                <h3>Level 80 Stats</h3>

                <div class="character-stat-grid">
                    {character.level_80_stats.hp !== undefined && (
                        <span>
                            HP
                            <strong>{character.level_80_stats.hp}</strong>
                        </span>
                    )}

                    {character.level_80_stats.atk !== undefined && (
                        <span>
                            ATK
                            <strong>{character.level_80_stats.atk}</strong>
                        </span>
                    )}

                    {character.level_80_stats.def !== undefined && (
                        <span>
                            DEF
                            <strong>{character.level_80_stats.def}</strong>
                        </span>
                    )}

                    {character.level_80_stats.spd !== undefined && (
                        <span>
                            SPD
                            <strong>{character.level_80_stats.spd}</strong>
                        </span>
                    )}

                    {character.max_energy !== undefined && (
                        <span>
                            Energy
                            <strong>{character.max_energy}</strong>
                        </span>
                    )}
                </div>
            </section>
        )
    }

    <!-- ========================= -->
    <!-- Abilities                 -->
    <!-- ========================= -->

    <section class="character-info-section">
        <h3>Abilities</h3>

        <div class="character-info-details">
            {
                abilities.map(({ id, ability }) => {
                    const minLevel = ability.min_level ?? 1;

                    const maxLevel = ability.max_level ?? minLevel;

                    const defaultLevel = getDefaultLevel(ability);

                    const levels = getAbilityLevels(ability);

                    const scalable =
                        Boolean(
                            ability.description_template && ability.scaling,
                        ) && maxLevel > minLevel;

                    return (
                        <details open data-character-ability={id}>
                            <summary>
                                <strong>{ability.type}</strong>

                                <span>{ability.name}</span>

                                {scalable && (
                                    <span
                                        class="character-ability-level"
                                        data-character-level-value
                                    >
                                        Lv. {defaultLevel}
                                    </span>
                                )}
                            </summary>

                            <div class="character-detail-body">
                                {ability.tag && (
                                    <p class="character-ability-tag">
                                        <strong>Type:</strong> {ability.tag}
                                    </p>
                                )}

                                <div class="character-detail-meta">
                                    {ability.energy_gain !== undefined && (
                                        <span>
                                            Energy Gain:{' '}
                                            <strong>
                                                {ability.energy_gain}
                                            </strong>
                                        </span>
                                    )}

                                    {ability.energy_cost !== undefined && (
                                        <span>
                                            Energy Cost:{' '}
                                            <strong>
                                                {ability.energy_cost}
                                            </strong>
                                        </span>
                                    )}

                                    {ability.break !== undefined && (
                                        <span>
                                            Break:{' '}
                                            <strong>{ability.break}</strong>
                                        </span>
                                    )}
                                </div>

                                {scalable && (
                                    <div class="character-trace-slider">
                                        <div class="character-slider-header">
                                            <strong>Trace Level</strong>

                                            <span data-character-level-value>
                                                Lv. {defaultLevel}
                                            </span>
                                        </div>

                                        <input
                                            type="range"
                                            min={minLevel}
                                            max={maxLevel}
                                            step="1"
                                            value={defaultLevel}
                                            data-character-level-slider
                                            aria-label={`${ability.name} Trace Level`}
                                        />

                                        <div class="character-slider-bounds">
                                            <span>Lv. {minLevel}</span>

                                            <span>Lv. {maxLevel}</span>
                                        </div>
                                    </div>
                                )}

                                <div class="character-ability-description">
                                    {scalable ? (
                                        levels.map((level) => (
                                            <p
                                                data-character-level-panel={
                                                    level
                                                }
                                                hidden={level !== defaultLevel}
                                            >
                                                {renderCharacterAbilityDescription(
                                                    ability,
                                                    level,
                                                )}
                                            </p>
                                        ))
                                    ) : (
                                        <p>
                                            {renderCharacterAbilityDescription(
                                                ability,
                                            )}
                                        </p>
                                    )}
                                </div>
                            </div>
                        </details>
                    );
                })
            }
        </div>
    </section>

    <!-- ========================= -->
    <!-- Major Traces              -->
    <!-- ========================= -->

    <section class="character-info-section">
        <h3>Major Traces</h3>

        <div class="character-info-details">
            {
                majorTraces.map(([ascension, trace]) => (
                    <details open>
                        <summary>
                            <strong>Ascension {ascension}</strong>

                            <span>{trace.name}</span>
                        </summary>

                        <div class="character-detail-body">
                            <p>{trace.description}</p>
                        </div>
                    </details>
                ))
            }
        </div>
    </section>

    <!-- ========================= -->
    <!-- Stat Bonuses              -->
    <!-- ========================= -->

    <section class="character-info-section">
        <h3>Stat Bonuses</h3>

        <div class="character-stat-grid">
            {
                character.stat_bonuses.map((bonus) => (
                    <span>
                        {bonus.stat}

                        <strong>{bonus.value}</strong>
                    </span>
                ))
            }
        </div>
    </section>

    <!-- ========================= -->
    <!-- Eidolons                  -->
    <!-- ========================= -->

    <section class="character-info-section">
        <h3>Eidolons</h3>

        <div class="character-info-details">
            {
                eidolons.map((eidolon) => (
                    <details open>
                        <summary>
                            <strong>E{eidolon.level}</strong>

                            <span>{eidolon.name}</span>
                        </summary>

                        <div class="character-detail-body">
                            <p>{eidolon.description}</p>
                        </div>
                    </details>
                ))
            }
        </div>
    </section>
</section>

<script>
    document
        .querySelectorAll<HTMLElement>('[data-character-ability]')
        .forEach((ability) => {
            const slider = ability.querySelector<HTMLInputElement>(
                '[data-character-level-slider]',
            );

            if (!slider) {
                return;
            }

            const levelLabels = ability.querySelectorAll<HTMLElement>(
                '[data-character-level-value]',
            );

            const panels = ability.querySelectorAll<HTMLElement>(
                '[data-character-level-panel]',
            );

            const updateLevel = () => {
                const level = slider.value;

                levelLabels.forEach((label) => {
                    label.textContent = `Lv. ${level}`;
                });

                panels.forEach((panel) => {
                    panel.hidden = panel.dataset.characterLevelPanel !== level;
                });
            };

            slider.addEventListener('input', updateLevel);
        });
</script>

<style>
    .character-info-card {
        box-sizing: border-box;

        width: 100%;
        max-width: 100%;
        min-width: 0;

        margin-top: 1.5rem;
    }

    .character-info-section {
        box-sizing: border-box;

        width: 100%;
        max-width: 100%;
        min-width: 0;
    }

    .character-info-section + .character-info-section {
        margin-top: 1.5rem;
    }

    .character-stat-grid {
        display: grid;

        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));

        width: 100%;
        min-width: 0;

        gap: 0.75rem;
    }

    .character-stat-grid > span {
        display: flex;

        justify-content: space-between;

        gap: 0.75rem;

        min-width: 0;

        padding: 0.65rem 0.8rem;

        border: 1px solid color-mix(in srgb, currentColor 15%, transparent);

        border-radius: 0.5rem;
    }

    .character-info-details {
        display: grid;

        width: 100%;
        max-width: 100%;
        min-width: 0;

        gap: 0.5rem;
    }

    .character-info-details details {
        box-sizing: border-box;

        width: 100%;
        max-width: 100%;
        min-width: 0;

        border: 1px solid color-mix(in srgb, currentColor 15%, transparent);

        border-radius: 0.5rem;

        overflow: hidden;
    }

    .character-info-details summary {
        box-sizing: border-box;

        display: flex;
        align-items: center;

        width: 100%;
        max-width: 100%;
        min-width: 0;

        gap: 0.75rem;

        padding: 0.7rem 0.8rem;

        cursor: pointer;
    }

    .character-info-details summary > span {
        min-width: 0;

        overflow-wrap: anywhere;
    }

    .character-ability-level {
        margin-left: auto;

        flex: 0 0 auto;

        opacity: 0.75;
    }

    .character-detail-body {
        box-sizing: border-box;

        width: 100%;
        max-width: 100%;
        min-width: 0;

        padding: 0 0.8rem 0.8rem;
    }

    .character-detail-body p {
        max-width: 100%;
        min-width: 0;

        overflow-wrap: anywhere;
    }

    .character-ability-tag {
        margin-top: 0;
    }

    .character-detail-meta {
        display: flex;
        flex-wrap: wrap;

        gap: 0.5rem 1rem;

        margin-bottom: 0.75rem;

        font-size: 0.9rem;

        opacity: 0.8;
    }

    .character-trace-slider {
        box-sizing: border-box;

        display: grid;

        width: 50%;
        max-width: 420px;
        min-width: 240px;

        gap: 0.3rem;

        margin: 0.75rem 0;
    }
    @media (max-width: 600px) {
        .character-trace-slider {
            width: 100%;
            min-width: 0;
            max-width: none;
        }
    }

    .character-slider-header {
        display: flex;

        justify-content: space-between;

        gap: 1rem;
    }

    .character-trace-slider input {
        box-sizing: border-box;

        display: block;

        width: 100%;
        min-width: 0;

        cursor: pointer;
    }

    .character-slider-bounds {
        display: flex;

        justify-content: space-between;

        font-size: 0.75rem;

        opacity: 0.65;
    }

    .character-ability-description {
        box-sizing: border-box;

        width: 100%;
        max-width: 100%;
        min-width: 0;

        padding-top: 0.25rem;
    }

    .character-ability-description p {
        width: 100%;
        max-width: 100%;
        min-width: 0;

        margin-bottom: 0;

        line-height: 1.5;

        overflow-wrap: anywhere;
    }
</style>
