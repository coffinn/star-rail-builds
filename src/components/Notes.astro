---
import { t } from '../utils/i18n';

const { notes, buildNote, locale } = Astro.props;

type RenderedNote = {
    id: string;
    name: string;
    note: string;
};

const itemNotes: RenderedNote[] = [
    ...(notes.lightCones?.items ?? []),

    ...(notes.relics?.sets ?? []),
    ...(notes.relics?.mainstats ?? []),
    ...(notes.relics?.substats ?? []),

    ...(notes.recommendedStats?.items ?? []),

    ...(notes.traces?.items ?? []),
];

const globalNotes: string[] = [
    ...(notes.lightCones?.global ?? []),
    ...(notes.relics?.global ?? []),
    ...(notes.recommendedStats?.global ?? []),
    ...(notes.traces?.global ?? []),
];

const hasNotes =
    itemNotes.length > 0 ||
    globalNotes.length > 0 ||
    buildNote?.notes?.length > 0;

const overview = buildNote?.overview;

const hasSummary =
    Boolean(overview?.summary);

const hasInvestment =
    Boolean(
        overview?.investment_priority?.priority ||
        overview?.investment_priority?.details,
    );

const hasOverview =
    hasSummary || hasInvestment;
---

{
    hasNotes && (
        <div class="card notes-card">
            <h2>{t(locale, 'ui', 'Notes')}</h2>

            <div class="notes-content">
                {
                    buildNote?.notes?.length > 0 && (
                        <div class="notes-block">
                            <div class="build-note-list">
                                {buildNote.notes.map(
                                    (note: string) => (
                                        <div set:html={note} />
                                    ),
                                )}
                            </div>
                        </div>
                    )
                }

                {
                    globalNotes.length > 0 && (
                        <div class="notes-global-list">
                            {globalNotes.map((note) => (
                                <div
                                    class="note-global"
                                    set:html={note}
                                />
                            ))}
                        </div>
                    )
                }

                {
                    itemNotes.length > 0 && (
                        <div class="note-list">
                            {itemNotes.map((note) => (
                                <div
                                    id={note.id}
                                    class="note-target"
                                    set:html={`<span class="element-bold">${note.name}:</span> ${note.note}`}
                                />
                            ))}
                        </div>
                    )
                }
            </div>
        </div>
    )
}

{
    hasOverview && (
        <div class="card notes-card overview-card">
            <h2>
                {t(locale, 'ui', 'Overview')}
            </h2>

            <div class="overview-content">
                {
                    hasSummary && (
                        <section class="overview-section">
                            <h3>
                                {t(
                                    locale,
                                    'ui',
                                    'Summary and General Analysis',
                                )}
                            </h3>

                            <div
                                class="overview-text"
                                set:html={
                                    overview.summary
                                }
                            />
                        </section>
                    )
                }

                {
                    hasInvestment && (
                        <section class="overview-section">
                            <h3>
                                {t(
                                    locale,
                                    'ui',
                                    'Investment Priority',
                                )}
                            </h3>

                            {
                                overview
                                    .investment_priority
                                    ?.priority && (
                                    <div
                                        class="overview-investment-priority"
                                        set:html={
                                            overview
                                                .investment_priority
                                                .priority
                                        }
                                    />
                                )
                            }

                            {
                                overview
                                    .investment_priority
                                    ?.details && (
                                    <div
                                        class="overview-text"
                                        set:html={
                                            overview
                                                .investment_priority
                                                .details
                                        }
                                    />
                                )
                            }
                        </section>
                    )
                }
            </div>
        </div>
    )
}