---
import { t } from '../utils/i18n';
import InlineNoteLabel from './InlineNoteLabel.astro';

type RecommendedStat = {
    name: string;
    baseline?: string | number;
    recommended?: string | number;
    note?: string | Record<string, string>;
    noteId?: string;
};

type RecommendedStatsData = {
    stats: RecommendedStat[];
};

const { stats, locale } = Astro.props as {
    stats: RecommendedStatsData;
    locale: any;
};

const hasValue = (value: string | number | undefined) =>
    value !== undefined && value !== null && value !== '';

/*
 * Recommended is always preferred.
 *
 * Legacy/fallback behavior:
 * if Recommended is empty, use Baseline.
 */
const getStatValue = (stat: RecommendedStat) => {
    if (hasValue(stat.recommended)) {
        return String(stat.recommended);
    }

    if (hasValue(stat.baseline)) {
        return String(stat.baseline);
    }

    return '—';
};
---

<div class="card recommendation-card recommended-stats-card">
    <h2>
        {t(locale, 'ui', 'Recommended Stats', undefined, false)}
    </h2>

    <div class="recommendation-card-body">
        <div class="recommended-stats-table">
            <div class="recommended-stats-header">
                <span>{t(locale, 'ui', 'Stat')}</span>

                <span>
                    {t(locale, 'ui', 'Recommended', undefined, false)}
                </span>
            </div>

            {
                stats.stats.map((stat) => (
                    <div class="recommended-stat-row">
                        <strong>
                            <InlineNoteLabel
                                label={stat.name}
                                noteId={stat.noteId}
                                hasNote={Boolean(stat.noteId || stat.note)}
                                emphasized
                            />
                        </strong>

                        <span class="recommended-stat-value">
                            {getStatValue(stat)}
                        </span>
                    </div>
                ))
            }
        </div>
    </div>
</div>
