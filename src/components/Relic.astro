---
import RelicSetGroup from './RelicSetGroup.astro';
import { t } from '../utils/i18n';

type RelicSetItem = {
    name: string;
    pieces: number;
    note?: string;
    noteId?: string;
};

type RelicSetGroupData = {
    items?: RelicSetItem[];
    choose?: boolean;
    choices?: { items: RelicSetItem[] }[];
};

type RelicSetRank = {
    groups: RelicSetGroupData[];
};

type RelicRecommendations = {
    sets: {
        relic_sets?: RelicSetRank[];
        planar_ornaments?: RelicSetRank[];
        conditional?: RelicSetGroupData[];
    };
};

const {
    relics,
    locale,
    lang = 'en',
} = Astro.props as {
    relics: RelicRecommendations;
    locale: any;
    lang?: string;
};

const sections = [
    {
        title: t(locale, 'ui', 'Relic Sets', undefined, false),
        ranks: relics.sets.relic_sets ?? [],
    },
    {
        title: t(locale, 'ui', 'Planar Ornaments', undefined, false),
        ranks: relics.sets.planar_ornaments ?? [],
    },
];

const conditionalGroups = relics.sets.conditional ?? [];
---

<div class="card recommendation-card artifact-card artifact-sets-card">
    <h2>{t(locale, 'ui', 'Relics', undefined, false)}</h2>

    <div class="recommendation-card-body">
        {
            sections.map((section) => (
                <div class="section recommendation-section">
                    <div class="conditional-heading">
                        {section.title}
                    </div>

                    <div class="rank-list">
                        {section.ranks.map(
                            (rank: RelicSetRank, i: number) => {
                                const [mainGroup, ...alternativeGroups] =
                                    rank.groups;

                                return (
                                    <div class="rank-group">
                                        {mainGroup && (
                                            <div class="rank-row">
                                                <strong class="rank-number">
                                                    {i + 1}
                                                </strong>

                                                <div class="rank-content artifact-set-content">
                                                    <RelicSetGroup
                                                        group={mainGroup}
                                                        locale={locale}
                                                        lang={lang}
                                                    />
                                                </div>
                                            </div>
                                        )}

                                        {alternativeGroups.map((group) => (
                                            <div class="rank-row alt">
                                                <span class="rank-approx">
                                                    &asymp;
                                                </span>

                                                <div class="rank-content artifact-set-content">
                                                    <RelicSetGroup
                                                        group={group}
                                                        locale={locale}
                                                        lang={lang}
                                                    />
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                );
                            },
                        )}
                    </div>
                </div>
            ))
        }

        {
            conditionalGroups.length > 0 && (
                <div class="conditional-list">
                    <div class="conditional-heading">
                        {t(locale, 'ui', 'Conditional (See Notes):')}
                    </div>

                    <div class="rank-list">
                        {conditionalGroups.map(
                            (group: RelicSetGroupData) => (
                                <div class="rank-row conditional-row">
                                    <span
                                        class="rank-marker"
                                        aria-hidden="true"
                                    />

                                    <div class="rank-content artifact-set-content">
                                        <RelicSetGroup
                                            group={group}
                                            locale={locale}
                                            lang={lang}
                                        />
                                    </div>
                                </div>
                            ),
                        )}
                    </div>
                </div>
            )
        }
    </div>
</div>