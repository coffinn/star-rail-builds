---
import InlineNoteLabel from './InlineNoteLabel.astro';
import LightConeInfoPopover from './LightConeInfoPopover.astro';
import { t } from '../utils/i18n';

import type {
    LightConePassiveText,
    LightConePassiveValue,
} from '../utils/light-cone-passive';

type LightConeItem = {
    id?: string;
    name: string;
    rarity: number;

    info?: {
        rarity: number;
        source?: string;
        free?: boolean;

        passive?: LightConePassiveText;

        s1?: LightConePassiveValue[];
        s2?: LightConePassiveValue[];
        s3?: LightConePassiveValue[];
        s4?: LightConePassiveValue[];
        s5?: LightConePassiveValue[];

        level_1?: {
            hp?: number;
            atk?: number;
            def?: number;
        };

        level_max?: {
            hp?: number;
            atk?: number;
            def?: number;
        };
    };

    superimposition?:
        | number
        | string;

    note?: string;
    noteId?: string;
};

type LightConeRank = {
    items: LightConeItem[];
};

type LightConeRecommendations = {
    light_cones: LightConeRank[];
    conditional?: LightConeItem[];
};

const {
    lightCones,
    locale,
    lang = 'en',
} = Astro.props as {
    lightCones:
        LightConeRecommendations;

    locale: any;
    lang?: string;
};

/**
 * Formats a Superimposition value.
 */
const formatSuperimposition = (
    superimposition?:
        | number
        | string,
) =>
    superimposition
        ? ` [S${superimposition}]`
        : '';

const hasNoteMarker = (
    item: LightConeItem,
) =>
    item.noteId ||
    item.note;

const isFreeLightCone = (
    item: LightConeItem,
) =>
    item.info?.free === true ||
    item.rarity <= 3;

const conditionalLightCones =
    lightCones.conditional ?? [];

const rankedLightConeGroups =
    lightCones.light_cones.map(
        (
            position: LightConeRank,
            index: number,
        ) => ({
            rank: index + 1,

            mainItem:
                position.items[0],

            alternativeItems:
                position.items.slice(1),
        }),
    );

const hasFreeLightCone =
    rankedLightConeGroups.some(
        (position) =>
            Boolean(
                position.mainItem &&
                    isFreeLightCone(
                        position.mainItem,
                    ),
            ) ||
            position.alternativeItems.some(
                (lightCone) =>
                    isFreeLightCone(
                        lightCone,
                    ),
            ),
    ) ||
    conditionalLightCones.some(
        (lightCone) =>
            isFreeLightCone(
                lightCone,
            ),
    );
---

<div class="card recommendation-card weapon-card">
    <h2>
        {t(locale, 'ui', 'Light Cones')}
    </h2>

    <div class="recommendation-card-body">
        {
            hasFreeLightCone && (
                <p class="free-weapon-note">
                    <span
                        class="free-weapon-note-mark"
                        aria-hidden="true"
                    />

                    {t(
                        locale,
                        'ui',
                        'Highlighted Light Cones are free options.',
                    )}
                </p>
            )
        }

        <div class="rank-list">
            {
                rankedLightConeGroups.map(
                    (position) => {
                        const mainItem =
                            position.mainItem;

                        const mainItemIsFree =
                            mainItem &&
                            isFreeLightCone(
                                mainItem,
                            );

                        return (
                            <div class="rank-group">
                                {mainItem && (
                                    <div
                                        class={`rank-row${
                                            mainItemIsFree
                                                ? ' is-free-weapon'
                                                : ''
                                        }`}
                                    >
                                        <strong class="rank-number">
                                            {
                                                position.rank
                                            }
                                        </strong>

                                        <span class="rank-content">
                                            <span class="inline-info-label">
                                                <LightConeInfoPopover
                                                    lightCone={
                                                        mainItem
                                                    }
                                                    locale={
                                                        locale
                                                    }
                                                    lang={
                                                        lang
                                                    }
                                                />

                                                {hasNoteMarker(
                                                    mainItem,
                                                ) && (
                                                    <InlineNoteLabel
                                                        label=""
                                                        noteId={
                                                            mainItem.noteId
                                                        }
                                                        hasNote={Boolean(
                                                            hasNoteMarker(
                                                                mainItem,
                                                            ),
                                                        )}
                                                    />
                                                )}

                                                <span class="bold">
                                                    (
                                                    {
                                                        mainItem.rarity
                                                    }
                                                    {
                                                        '\u2605'
                                                    }
                                                    )
                                                    {formatSuperimposition(
                                                        mainItem.superimposition,
                                                    )}
                                                </span>
                                            </span>
                                        </span>
                                    </div>
                                )}

                                {position.alternativeItems.map(
                                    (
                                        lightCone,
                                    ) => {
                                        const isFree =
                                            isFreeLightCone(
                                                lightCone,
                                            );

                                        return (
                                            <div
                                                class={`rank-row alt${
                                                    isFree
                                                        ? ' is-free-weapon'
                                                        : ''
                                                }`}
                                            >
                                                <span class="rank-approx">
                                                    &asymp;
                                                </span>

                                                <span class="rank-content">
                                                    <span class="inline-info-label">
                                                        <LightConeInfoPopover
                                                            lightCone={
                                                                lightCone
                                                            }
                                                            locale={
                                                                locale
                                                            }
                                                            lang={
                                                                lang
                                                            }
                                                        />

                                                        {hasNoteMarker(
                                                            lightCone,
                                                        ) && (
                                                            <InlineNoteLabel
                                                                label=""
                                                                noteId={
                                                                    lightCone.noteId
                                                                }
                                                                hasNote={Boolean(
                                                                    hasNoteMarker(
                                                                        lightCone,
                                                                    ),
                                                                )}
                                                            />
                                                        )}

                                                        <span class="bold">
                                                            (
                                                            {
                                                                lightCone.rarity
                                                            }
                                                            {
                                                                '\u2605'
                                                            }
                                                            )
                                                            {formatSuperimposition(
                                                                lightCone.superimposition,
                                                            )}
                                                        </span>
                                                    </span>
                                                </span>
                                            </div>
                                        );
                                    },
                                )}
                            </div>
                        );
                    },
                )
            }
        </div>

        {
            conditionalLightCones.length >
                0 && (
                <div class="conditional-list">
                    <div class="conditional-heading">
                        {t(
                            locale,
                            'ui',
                            'Conditional (See Notes):',
                        )}
                    </div>

                    <div class="rank-list">
                        {conditionalLightCones.map(
                            (
                                lightCone:
                                    LightConeItem,
                            ) => {
                                const isFree =
                                    isFreeLightCone(
                                        lightCone,
                                    );

                                return (
                                    <div
                                        class={`rank-row conditional-row${
                                            isFree
                                                ? ' is-free-weapon'
                                                : ''
                                        }`}
                                    >
                                        <span
                                            class="rank-marker"
                                            aria-hidden="true"
                                        />

                                        <span class="rank-content">
                                            <span class="inline-info-label">
                                                <LightConeInfoPopover
                                                    lightCone={
                                                        lightCone
                                                    }
                                                    locale={
                                                        locale
                                                    }
                                                    lang={
                                                        lang
                                                    }
                                                />

                                                {hasNoteMarker(
                                                    lightCone,
                                                ) && (
                                                    <InlineNoteLabel
                                                        label=""
                                                        noteId={
                                                            lightCone.noteId
                                                        }
                                                        hasNote={Boolean(
                                                            hasNoteMarker(
                                                                lightCone,
                                                            ),
                                                        )}
                                                    />
                                                )}

                                                <span class="bold">
                                                    (
                                                    {
                                                        lightCone.rarity
                                                    }
                                                    {
                                                        '\u2605'
                                                    }
                                                    )
                                                    {formatSuperimposition(
                                                        lightCone.superimposition,
                                                    )}
                                                </span>
                                            </span>
                                        </span>
                                    </div>
                                );
                            },
                        )}
                    </div>
                </div>
            )
        }
    </div>
</div>