---
import { SpeedDial } from 'webcoreui/astro';
import type { SpeedDialProps } from 'webcoreui/astro';
import { alert, github, search } from 'webcoreui/icons';
import { features } from '../config/features';

const iconWithTitle = (
    svg: string,
    title: string,
) =>
    svg
        .replace(
            '<svg ',
            '<svg role="img" ',
        )
        .replace(
            '>',
            `><title>${title}</title>`,
        );

const speedDialItems: SpeedDialProps['items'] = [
    {
        icon: iconWithTitle(
            search,
            'Search',
        ),
        href: '#site-search-modal',
        tooltip: 'Search',
    },

    {
        icon: iconWithTitle(
            github,
            'Open GitHub',
        ),
        href: 'https://github.com/coffinn/star-rail-builds',
        tooltip: 'View GitHub',
        target: '_blank',
    },

    ...(features.feedback
        ? [
              {
                  icon: iconWithTitle(
                      alert,
                      'Open feedback form',
                  ),
                  href: '#feedback-modal',
                  tooltip: 'Send Feedback',
              },
          ]
        : []),
];
---

<SpeedDial
    items={speedDialItems}
    circular={true}
    triggerOnClick={true}
    className="speed-dial"
/>