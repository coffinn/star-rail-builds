---
import InlineNoteLabel from './InlineNoteLabel.astro';
import { resolveRelicAssetUrl } from '../utils/item-assets';

type LocalizedRelicEffect = {
    en?: string;
    [lang: string]: string | undefined;
};

type RelicSetInfo = {
    rarity: number;
    '1p'?: LocalizedRelicEffect;
    '2p'?: LocalizedRelicEffect;
    '4p'?: LocalizedRelicEffect;
};

type Props = {
    relic: {
        name: string;
        id?: string;
        info?: RelicSetInfo;
    };
    lang?: string;
};

const {
    relic,
    lang = 'en',
} = Astro.props as Props;

const info = relic.info;

function escapeHtml(value: unknown) {
    return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

/**
 * Selects the localized set effect with English fallback.
 */
const localizedEffect = (
    effect?: LocalizedRelicEffect,
) => effect?.[lang] ?? effect?.en ?? '';

const effects = info
    ? [
          {
              label: '1P',
              value: localizedEffect(info['1p']),
          },
          {
              label: '2P',
              value: localizedEffect(info['2p']),
          },
          {
              label: '4P',
              value: localizedEffect(info['4p']),
          },
      ].filter((effect) => effect.value)
    : [];

const imageUrl = relic.id
    ? resolveRelicAssetUrl(relic.id)
    : '';

const popoverCardHtml = info
    ? [
          '<span class="info-popover-header',
          imageUrl ? ' has-image' : '',
          '">',

          imageUrl
              ? [
                    '<span class="info-popover-image artifact-popover-image"><img src="',
                    escapeHtml(imageUrl),
                    '" alt="" loading="lazy" decoding="async"></span>',
                ].join('')
              : '',

          '<span class="info-popover-name">',
          escapeHtml(relic.name),
          '</span>',

          '<span class="info-popover-rarity">',
          escapeHtml(info.rarity),
          ' \u2605</span>',

          '</span>',

          effects
              .map((effect) =>
                  [
                      '<span class="info-popover-stat artifact-popover-effect"><span>',
                      escapeHtml(effect.label),
                      '</span><strong>',
                      escapeHtml(effect.value),
                      '</strong></span>',
                  ].join(''),
              )
              .join(''),
      ].join('')
    : '';
---

{
    info ? (
        <span
            class="info-popover artifact-popover"
            data-info-popover-card-class="artifact-popover-card"
            data-info-popover-html={popoverCardHtml}
        >
            <span
                class="info-popover-trigger artifact-popover-trigger"
                role="button"
                tabindex="0"
                aria-expanded="false"
            >
                <InlineNoteLabel
                    label={relic.name}
                    emphasized
                />
            </span>
        </span>
    ) : (
        <InlineNoteLabel
            label={relic.name}
            emphasized
        />
    )
}