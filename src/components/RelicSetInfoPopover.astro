---
import InlineNoteLabel from './InlineNoteLabel.astro';
import { resolveRelicAssetUrl } from '../utils/item-assets';
import { t } from '../utils/i18n';

type LocalizedRelicEffect = {
    en?: string;
    [lang: string]: string | undefined;
};

type RelicSetInfo = {
    rarity: number;
    '1p'?: LocalizedRelicEffect;
    '2p'?: LocalizedRelicEffect;
    '4p'?: LocalizedRelicEffect;
};

type AggregateRelicSet = {
    id: string;
    name: string;
    info: RelicSetInfo;
};

type Props = {
    relic: {
        name: string;
        pieces?: number;
        id?: string;
        info?: RelicSetInfo;
        aggregateSets?: AggregateRelicSet[];
    };
    locale: any;
    lang?: string;
};

const { relic, locale, lang = 'en' } = Astro.props as Props;

const info = relic.info;
const aggregateSets = relic.aggregateSets ?? [];

function escapeHtml(value: unknown) {
    return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

/**
 * Selects the localized set effect with English fallback.
 */
const localizedEffect = (effect?: LocalizedRelicEffect) =>
    effect?.[lang] ?? effect?.en ?? '';

const effects = info
    ? [
          {
              label: t(locale, 'ui', '1-Pc', undefined, false),
              value: localizedEffect(info['1p']),
          },
          {
              label: t(locale, 'ui', '2-Pc', undefined, false),
              value: localizedEffect(info['2p']),
          },
          {
              label: t(locale, 'ui', '4-Pc', undefined, false),
              value: localizedEffect(info['4p']),
          },
      ].filter((effect) => effect.value)
    : [];

const imageUrl = relic.id ? resolveRelicAssetUrl(relic.id) : '';

const regularPopoverCardHtml = info
    ? [
          '<span class="info-popover-header',
          imageUrl ? ' has-image' : '',
          '">',

          imageUrl
              ? [
                    '<span class="info-popover-image artifact-popover-image"><img src="',
                    escapeHtml(imageUrl),
                    '" alt="" loading="lazy" decoding="async"></span>',
                ].join('')
              : '',

          '<span class="info-popover-name">',
          escapeHtml(relic.name),
          '</span>',

          '<span class="info-popover-rarity">',
          escapeHtml(info.rarity),
          ' \u2605</span>',

          '</span>',

          effects
              .map((effect) =>
                  [
                      '<span class="info-popover-stat artifact-popover-effect"><span>',
                      escapeHtml(effect.label),
                      '</span><strong>',
                      escapeHtml(effect.value),
                      '</strong></span>',
                  ].join(''),
              )
              .join(''),
      ].join('')
    : '';

const aggregatePieces = relic.pieces ?? 2;
const aggregatePieceKey = `${aggregatePieces}p` as '1p' | '2p' | '4p';

const aggregatePieceLabel = t(
    locale,
    'ui',
    `${aggregatePieces}-Pc`,
    undefined,
    false,
);

const aggregatePopoverCardHtml =
    aggregateSets.length > 0
        ? [
              '<span class="info-popover-header">',
              '<span class="info-popover-name">',
              escapeHtml(relic.name),
              '</span>',
              '</span>',

              '<span class="artifact-aggregate-list">',

              aggregateSets
                  .map((set) => {
                      const setImageUrl = resolveRelicAssetUrl(set.id);

                      const effect = localizedEffect(
                          set.info?.[aggregatePieceKey],
                      );

                      return [
                          '<span class="artifact-aggregate-set',
                          setImageUrl ? ' has-image' : '',
                          '">',

                          setImageUrl
                              ? [
                                    '<span class="artifact-aggregate-set-image"><img src="',
                                    escapeHtml(setImageUrl),
                                    '" alt="" loading="lazy" decoding="async"></span>',
                                ].join('')
                              : '',

                          '<span class="artifact-aggregate-set-copy">',

                          '<strong class="artifact-aggregate-set-name">',
                          escapeHtml(set.name),
                          '</strong>',

                          effect
                              ? [
                                    '<span class="artifact-aggregate-set-effect">',
                                    '<span>',
                                    escapeHtml(aggregatePieceLabel),
                                    '</span>',
                                    '<strong>',
                                    escapeHtml(effect),
                                    '</strong>',
                                    '</span>',
                                ].join('')
                              : '',

                          '</span>',
                          '</span>',
                      ].join('');
                  })
                  .join(''),

              '</span>',
          ].join('')
        : '';

const popoverCardHtml = aggregatePopoverCardHtml || regularPopoverCardHtml;

const hasPopover = Boolean(popoverCardHtml);
---

{
    hasPopover ? (
        <span
            class="info-popover artifact-popover"
            data-info-popover-card-class="artifact-popover-card"
            data-info-popover-html={popoverCardHtml}
        >
            <span
                class="info-popover-trigger artifact-popover-trigger"
                role="button"
                tabindex="0"
                aria-expanded="false"
            >
                <InlineNoteLabel label={relic.name} emphasized />
            </span>
        </span>
    ) : (
        <InlineNoteLabel label={relic.name} emphasized />
    )
}
